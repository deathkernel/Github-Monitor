GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
POLL_INTERVAL_SECONDS=300
DETAIL_REPO_LIMIT=15
DATABASE_URL=sqlite:///./data/github_monitor.db

# API protection
RATE_SOFT_FLOOR=500
RATE_HARD_FLOOR=100
REQUEST_RETRY_LIMIT=3

# Optional outbound webhook notifications
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_MIN_SEVERITY=warning

# Mutating GitHub actions are OFF by default
ENABLE_WRITE_ACTIONS=false

# Background job lease
JOB_LEASE_SECONDS=900
